<?xml version="1.0" encoding="utf-8"?>
<!--
  server.hsconf template for HomeScope OutSystems 11 servers.
  Rendered on each server by templates/bootstrap.ps1.tftpl ({{TOKENS}}).
  Passwords are NOT stored here: they are passed to
  ConfigurationTool.com /SetupInstall from Secrets Manager at boot.
  Regenerate the full schema for your exact Platform Server release with
  `ConfigurationTool.com /GenerateTemplates` and keep the tokens below.
-->
<EnvironmentConfiguration>
  <PlatformDatabaseConfiguration>
    <SqlServerConfiguration>
      <Server>{{DB_HOST}}</Server>
      <Catalog>outsystems</Catalog>
      <AdminUser>{{DB_ADMIN_USER}}</AdminUser>
      <RuntimeUser>{{DB_RUNTIME_USER}}</RuntimeUser>
      <AdvancedConfiguration>Encrypt=True;TrustServerCertificate=False</AdvancedConfiguration>
      <UsedAuthenticationMode>Database Authentication</UsedAuthenticationMode>
    </SqlServerConfiguration>
  </PlatformDatabaseConfiguration>
  <LoggingDatabaseConfiguration>
    <SqlServerConfiguration>
      <Server>{{DB_HOST}}</Server>
      <Catalog>outsystems_log</Catalog>
      <AdminUser>{{DB_LOG_ADMIN_USER}}</AdminUser>
      <RuntimeUser>{{DB_LOG_RUNTIME_USER}}</RuntimeUser>
      <AdvancedConfiguration>Encrypt=True;TrustServerCertificate=False</AdvancedConfiguration>
    </SqlServerConfiguration>
  </LoggingDatabaseConfiguration>
  <SessionDatabaseConfiguration>
    <SqlServerConfiguration>
      <Server>{{DB_HOST}}</Server>
      <Catalog>outsystems_session</Catalog>
      <SessionUser>{{DB_SESSION_USER}}</SessionUser>
    </SqlServerConfiguration>
  </SessionDatabaseConfiguration>
  <ServiceConfiguration>
    <CompilerServerHostname>{{CONTROLLER_HOST}}</CompilerServerHostname>
    <DeploymentServerPort>12001</DeploymentServerPort>
    <DeploymentControllerServerPort>12000</DeploymentControllerServerPort>
    <SchedulerServerPort>12002</SchedulerServerPort>
    <ServerRole>{{SERVER_ROLE}}</ServerRole>
  </ServiceConfiguration>
  <CacheInvalidationConfiguration>
    <ServiceHost>{{CONTROLLER_HOST}}</ServiceHost>
    <ServicePort>5672</ServicePort>
    <VirtualHost>/OutSystems</VirtualHost>
  </CacheInvalidationConfiguration>
</EnvironmentConfiguration>
